{ 
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "rootDir": "./",
        "outDir": "./dist",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": "./",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "paths": {
            "@/*": ["src/*"]
        },
        "types": ["node", "jest", "express"]
    },
    "include": ["src/**/*"],
    "ts-node": {
        "require": ["tsconfig-paths/register"]
      }
}

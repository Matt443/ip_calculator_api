    "components": {
        "schemas": {
            "NetworkInfo": {
                "type": "object",
                "properties": {
                    "networkAddress": {
                        "$ref": "#/components/schemas/IpAllFormats"
                    },
                    "broadcastAddress": {
                        "$ref": "#/components/schemas/IpAllFormats"
                    },
                    "ipMask": {
                        "$ref": "#/components/schemas/IpAllFormats"
                    },
                    "hosts": {
                        "type": "object",
                        "properties": {
                            "first": {
                                "$ref": "#/components/schemas/IpAllFormats"
                            },
                            "last": {
                                "$ref": "#/components/schemas/IpAllFormats"
                            },
                            "quantity": { "type": "integer", "example": 126 }
                        }
                    }
                }
            },
            "IpAllFormats": {
                "type": "object",
                "properties": {
                    "binary": {
                        "type": "array",
                        "example": ["11111111", "11111111", "11111111", "00000000"]
                    },
                    "default": { "type": "array", "example": [255, 255, 255, 0] },
                    "decimal": { "type": "integer", "example": 4294967040 },
                    "shorthand": {
                        "type": "integer",
                        "maximum": 32,
                        "minimum": 0,
                        "example": 24
                    },
                    "dotted": { "type": "string", "example": "255.255.255.0" }
                },
                "required": ["binary", "default", "decimal", "dotted"]
            }
        }
    }
}

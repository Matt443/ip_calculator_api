{
    "openapi": "3.0.1",
    "info": {
        "title": "Sample API",
        "version": "1.0.0",
        "description": "This is a simple API example"
    },
    "servers": [{ "url": "http://localhost:3002" }],
    "paths": {
        "/api/ip/conversions/binary": {
            "get": {
                "summary": "Get IP address in binary form",
                "tags": ["Conversions"],
                "parameters": [
                    {
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "192.168.0.1"
                        },
                        "description": "Ip address in any format",
                        "required": true,
                        "name": "ip"
                    },
                    {
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": ["default", "binary", "decimal", "shorthand"]
                        },
                        "description": "Required for every type except of type: default",
                        "name": "type"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Converted address",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "given": {
                                            "type": "string",
                                            "example": "192.168.0.1"
                                        },
                                        "result": {
                                            "type": "object",
                                            "properties": {
                                                "joined": {
                                                    "type": "string",
                                                    "example": "11000000.10101000.00000000.00000001"
                                                },
                                                "separated": {
                                                    "type": "array",
                                                    "example": [
                                                        "11000000",
                                                        "10101000",
                                                        "00000000",
                                                        "00000001"
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Data incorrect"
                    }
                }
            }
        },

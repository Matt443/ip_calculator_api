                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "given": {
                                            "type": "object",
                                            "example": {
                                                "maskType": "binary",
                                                "mask": "11111111111111110000000000000000"
                                            }
                                        },
                                        "result": {
                                            "type": "object",
                                            "example": { "hostQuantity": 65534 }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Data incorrect"
                    }

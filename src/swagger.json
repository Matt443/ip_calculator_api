                    {
                        "in": "query",
                        "name": "subnetsQuantity",
                        "schema": {
                            "type": "number",
                            "example": 2
                        },
                        "description": "Number of subnets. One from parameters: subnetsQuantity and subnetsHostQuantity is required."
